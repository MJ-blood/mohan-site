---
import PostDate from './PostDate.astro';
import { postRoute, type PostData } from '../lib/post-source';
interface Props { post: PostData; archive?: boolean }
const { post, archive = false } = Astro.props;
---
<a class="article-row" href={postRoute(post.slug)} data-post={archive ? post.slug : undefined}>
  <div class="article-row-content">
    <h3>{post.title}</h3><p>{post.summary}</p>
    <div class="article-date"><PostDate post={post} /><span>约 {post.minutes} 分钟</span><span class="article-category">{post.tags[0] ?? '随笔'}</span></div>
  </div><span class="article-arrow" aria-hidden="true">↗</span>
</a>
