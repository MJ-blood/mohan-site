---
import SiteLayout from '../../layouts/SiteLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
---
<SiteLayout title="作品与实践 · mohan 的工作室" description="个人工具与实践记录：从遇到的问题、做出的选择，到具体产出与适用边界。" section="work">
  <div class="container showcase-container">
    <header class="page-intro"><p class="section-kicker">动手做过的事</p><h1>作品与实践</h1><p>从一个具体问题开始，留下工具、方法与实践中的判断。</p></header>
    <section class="listing-section" aria-label="作品与实践">
      <div class="work-grid"><WorkCard kind="knowledge" /><WorkCard kind="collaboration" /></div>
    </section>
  </div>
</SiteLayout>
