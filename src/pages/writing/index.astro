---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPosts } from '../../lib/content';
import PostCard from '../../components/PostCard.astro';
import { sortDate } from '../../lib/post-source';
const posts = await getPosts();
const tags = [...new Set(posts.flatMap(post => post.data.tags))].sort();
const groups = Map.groupBy(posts, post => sortDate(post.data).slice(0, 4) || '随笔');
const search = JSON.stringify(Object.fromEntries(posts.map(post => [post.data.slug, { text: post.data.search, tags: post.data.tags }]))).replace(/</g, '\u003c').replace(/>/g, '\u003e').replace(/&/g, '\u0026');
---
<SiteLayout title="文章 · mohan 的工作室" description="关于 AI 工程、知识管理和产品实践的文章。按主题浏览，或搜索一段你想找到的内容。" section="writing" bodyClass="writing-page">
<div class="container archive-container" data-archive>
  <header class="page-intro archive-intro"><h1>文章</h1><p>关于 AI、技术与产品，也关于如何把知识变成自己的东西。</p></header>
  <div class="archive-layout">
    <div class="archive-tools" aria-label="查找文章" hidden>
      <form class="search-form" role="search"><label class="visually-hidden" for="article-search">搜索文章</label><div class="search-field"><svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><input id="article-search" name="q" type="search" placeholder="搜索标题、关键词或正文" autocomplete="off"></div></form>
      <details class="topic-picker"><summary>主题：<span data-topic-label>全部</span><span class="disclosure-icon" aria-hidden="true"></span></summary><div class="topic-filters" role="group" aria-label="文章主题"><button type="button" class="topic-filter is-active" data-topic="" aria-pressed="true">全部</button>{tags.map(tag => <button type="button" class="topic-filter" data-topic={tag} aria-pressed="false">{tag}<span>{posts.filter(post => post.data.tags.includes(tag)).length}</span></button>)}</div></details>
    </div>
    <div class="archive-results"><div class="results-caption"><span>按最近更新排列</span><span id="result-count" role="status" aria-live="polite">共 {posts.length} 篇</span></div>{[...groups].map(([year, entries]) => <section class="archive-year" data-year><h2>{year}</h2><div class="article-list">{entries.map(post => <PostCard post={post.data} archive />)}</div></section>)}{posts.length === 0 && <p class="archive-no-posts">文章正在整理中。</p>}<div class="archive-empty" hidden><h2>暂时没有找到。</h2><p>试试更短的关键词，或查看全部文章。</p><button class="button button-secondary" type="button" data-clear-search>清除筛选</button></div></div>
  </div>
  <script is:inline type="application/json" id="article-search-index" set:html={search} />
</div>
</SiteLayout>
